# Copy to .env.production at the project root; never commit the real file.
SITE_ADDRESS=demo.example.com
FRONTEND_ORIGIN=https://demo.example.com
# Use a new strong password. URL-encode it in DATABASE_URL if needed.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://agent_demo:REPLACE_WITH_ENCODED_PASSWORD@db:5432/agent_demo
OPENAI_API_KEY=
# Only Caddy publishes ports; frontend/API/Postgres remain on the Docker network.
HTTP_BIND=80
HTTPS_BIND=443
