# Copy to .env for Docker Compose.
POSTGRES_DB=agent_demo
POSTGRES_USER=agent_demo
POSTGRES_PASSWORD=local_dev_password
DATABASE_URL=postgresql://agent_demo:local_dev_password@db:5432/agent_demo
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend only. Required for chunk embeddings, question retrieval, and answers.
# Fixed model: text-embedding-3-small, 1536 dimensions.
# Fixed answer model: gpt-4.1-mini-2025-04-14 (Responses API).
OPENAI_API_KEY=
